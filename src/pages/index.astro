---
// No server-side logic needed for this static UI yet
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>UTM Link Tracker</title>
    <!-- TailwindCSS is assumed to be linked via Astro config or global.css -->
    <link rel="stylesheet" href="/src/styles/global.css">
</head>
<body class="bg-gray-100 text-gray-800 font-sans">
    <main class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-center mb-8">UTM Link Tracker</h1>

        <!-- UTM Generator Form -->
        <section class="bg-white p-6 rounded-lg shadow-md mb-8">
            <h2 class="text-2xl font-semibold mb-4">Generate UTM Link</h2>
            <form id="utm-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="base-url" class="block text-sm font-medium text-gray-700 mb-1">Base URL*</label>
                    <input type="url" id="base-url" name="base-url" placeholder="https://example.com" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label for="utm-source" class="block text-sm font-medium text-gray-700 mb-1">UTM Source*</label>
                    <input type="text" id="utm-source" name="utm-source" placeholder="e.g., google, newsletter" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label for="utm-medium" class="block text-sm font-medium text-gray-700 mb-1">UTM Medium*</label>
                    <input type="text" id="utm-medium" name="utm-medium" placeholder="e.g., cpc, email" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label for="utm-campaign" class="block text-sm font-medium text-gray-700 mb-1">UTM Campaign*</label>
                    <input type="text" id="utm-campaign" name="utm-campaign" placeholder="e.g., summer_sale" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label for="utm-term" class="block text-sm font-medium text-gray-700 mb-1">UTM Term (Optional)</label>
                    <input type="text" id="utm-term" name="utm-term" placeholder="e.g., running+shoes" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label for="utm-content" class="block text-sm font-medium text-gray-700 mb-1">UTM Content (Optional)</label>
                    <input type="text" id="utm-content" name="utm-content" placeholder="e.g., logolink, textlink" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div class="md:col-span-2 flex justify-end">
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Generate Link
                    </button>
                </div>
            </form>
        </section>

        <!-- Preview Area -->
        <section class="bg-white p-6 rounded-lg shadow-md mb-8">
            <h2 class="text-2xl font-semibold mb-4">Generated Link Preview</h2>
            <div class="flex flex-col md:flex-row gap-4 items-center">
                <textarea id="generated-link" readonly class="w-full flex-grow px-3 py-2 border border-gray-300 rounded-md bg-gray-50 h-20 resize-none focus:outline-none" placeholder="Generated link will appear here..."></textarea>
                <button id="copy-button" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-md shadow-sm w-full md:w-auto focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                    Copy to Clipboard
                </button>
            </div>
        </section>

        <!-- Saved Links Table -->
        <section class="bg-white p-6 rounded-lg shadow-md">
            <h2 class="text-2xl font-semibold mb-4">Saved Links</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Base URL</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Campaign</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Source</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Medium</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Generated Link</th>
                            <th scope="col" class="relative px-6 py-3">
                                <span class="sr-only">Actions</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <!-- Placeholder Row 1 -->
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 truncate max-w-xs">https://example.com/page1</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">spring_promo</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">facebook</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">cpc</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-blue-600 hover:underline truncate max-w-xs">
                                <a href="#" title="https://example.com/page1?utm_source=facebook&utm_medium=cpc&utm_campaign=spring_promo">https://example.com/page1?utm_source=facebook...</a>
                            </td>
                             <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <button class="text-red-600 hover:text-red-900">Delete</button>
                            </td>
                        </tr>
                        <!-- Placeholder Row 2 -->
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 truncate max-w-xs">https://anothersite.org/feature</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">newsletter_launch</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">email</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">newsletter</td>
                             <td class="px-6 py-4 whitespace-nowrap text-sm text-blue-600 hover:underline truncate max-w-xs">
                                <a href="#" title="https://anothersite.org/feature?utm_source=email&utm_medium=newsletter&utm_campaign=newsletter_launch">https://anothersite.org/feature?utm_source=email...</a>
                            </td>
                             <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <button class="text-red-600 hover:text-red-900">Delete</button>
                            </td>
                        </tr>
                        <!-- More rows would go here -->
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
